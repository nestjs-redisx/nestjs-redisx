{
  "name": "@nestjs-redisx/session",
  "version": "1.11.0",
  "description": "Redis session management plugin for NestJS RedisX — express-session/@fastify/session store with per-user introspection, revocation, seat limits, and absolute lifetime caps",
  "author": "NestJS RedisX Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "SKIP_INTEGRATION=true vitest run",
    "test:watch": "SKIP_INTEGRATION=true vitest",
    "test:cov": "SKIP_INTEGRATION=true vitest run --coverage",
    "test:integration": "SKIP_INTEGRATION=false vitest run test/integration test/e2e --pool=forks --poolOptions.forks.singleFork=true",
    "test:integration:watch": "SKIP_INTEGRATION=false vitest watch test/integration",
    "docker:up": "cd ../.. && docker-compose up -d redis",
    "docker:down": "cd ../.. && docker-compose down",
    "docker:logs": "cd ../.. && docker-compose logs -f redis",
    "test:docker": "npm run docker:up && sleep 3 && npm run test:integration; TEST_EXIT=$?; npm run docker:down; exit $TEST_EXIT",
    "test:all": "npm run test:cov && npm run test:integration",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepublishOnly": "node ../../scripts/check-changelog.mjs"
  },
  "keywords": [
    "nestjs",
    "redis",
    "session",
    "express-session",
    "fastify-session",
    "session-store",
    "session-management",
    "revocation",
    "spring-session"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs-redisx/nestjs-redisx.git",
    "directory": "packages/session"
  },
  "homepage": "https://nestjs-redisx.dev/en/reference/session/",
  "bugs": {
    "url": "https://github.com/nestjs-redisx/nestjs-redisx/issues"
  },
  "peerDependencies": {
    "@fastify/session": ">=10.0.0",
    "@nestjs-redisx/core": "^1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "express-session": "^1.17.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "express-session": {
      "optional": true
    },
    "@fastify/session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/session": "^10.9.0",
    "@nestjs-redisx/testing": "^1.11.0",
    "@nestjs/testing": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.0.0",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "fastify": "^4.28.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
