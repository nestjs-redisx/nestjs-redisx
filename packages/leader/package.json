{
  "name": "@nestjs-redisx/leader",
  "version": "1.14.0",
  "description": "Leader election plugin for NestJS RedisX — run cron jobs, migrations, and cleanup on exactly one instance, with heartbeat leases and automatic failover",
  "author": "NestJS RedisX Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "SKIP_INTEGRATION=true vitest run",
    "test:watch": "SKIP_INTEGRATION=true vitest",
    "test:cov": "SKIP_INTEGRATION=true vitest run --coverage",
    "test:integration": "SKIP_INTEGRATION=false vitest run test/integration --pool=forks --poolOptions.forks.singleFork=true",
    "test:integration:watch": "SKIP_INTEGRATION=false vitest watch test/integration",
    "test:all": "npm run test:cov && npm run test:integration",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepublishOnly": "node ../../scripts/check-changelog.mjs"
  },
  "keywords": [
    "nestjs",
    "redis",
    "leader-election",
    "leader",
    "cron",
    "singleton",
    "scheduler",
    "failover",
    "distributed"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs-redisx/nestjs-redisx.git",
    "directory": "packages/leader"
  },
  "homepage": "https://nestjs-redisx.dev/en/reference/leader/",
  "bugs": {
    "url": "https://github.com/nestjs-redisx/nestjs-redisx/issues"
  },
  "peerDependencies": {
    "@nestjs-redisx/core": "^1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs-redisx/testing": "^1.14.0",
    "@nestjs/testing": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
