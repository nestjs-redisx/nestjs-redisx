{
  "name": "@nestjs-redisx/circuit-breaker",
  "version": "1.9.0",
  "description": "Distributed circuit breaker plugin for NestJS RedisX (closed/open/half-open) with a pure, time-injected state machine core",
  "author": "NestJS RedisX Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "SKIP_INTEGRATION=true vitest run",
    "test:watch": "SKIP_INTEGRATION=true vitest",
    "test:cov": "SKIP_INTEGRATION=true vitest run --coverage",
    "test:integration": "SKIP_INTEGRATION=false vitest run test/integration/circuit-breaker.integration.spec.ts",
    "test:integration:watch": "SKIP_INTEGRATION=false vitest watch test/integration/circuit-breaker.integration.spec.ts",
    "docker:up": "cd ../.. && docker-compose up -d redis",
    "docker:down": "cd ../.. && docker-compose down",
    "docker:logs": "cd ../.. && docker-compose logs -f redis",
    "test:docker": "npm run docker:up && sleep 3 && npm run test:integration; TEST_EXIT=$?; npm run docker:down; exit $TEST_EXIT",
    "test:all": "npm run test:cov && npm run test:integration",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\""
  },
  "keywords": [
    "nestjs",
    "redis",
    "circuit-breaker",
    "resilience",
    "fault-tolerance",
    "half-open",
    "state-machine"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs-redisx/nestjs-redisx.git",
    "directory": "packages/circuit-breaker"
  },
  "homepage": "https://nestjs-redisx.dev/en/reference/circuit-breaker/",
  "bugs": {
    "url": "https://github.com/nestjs-redisx/nestjs-redisx/issues"
  },
  "peerDependencies": {
    "@nestjs-redisx/core": "^1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs-redisx/testing": "^1.9.0",
    "@nestjs/testing": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
