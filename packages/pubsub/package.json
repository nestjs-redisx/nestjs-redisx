{
  "name": "@nestjs-redisx/pubsub",
  "version": "1.12.0",
  "description": "Redis Pub/Sub plugin for NestJS RedisX: typed publish/subscribe, pattern subscriptions, @Subscribe decorator with auto-discovery, and a dedicated subscriber connection",
  "author": "NestJS RedisX Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "SKIP_INTEGRATION=true vitest run",
    "test:watch": "SKIP_INTEGRATION=true vitest",
    "test:cov": "SKIP_INTEGRATION=true vitest run --coverage",
    "test:integration": "SKIP_INTEGRATION=false vitest run test/integration --pool=forks --poolOptions.forks.singleFork=true",
    "test:integration:watch": "SKIP_INTEGRATION=false vitest watch test/integration --pool=forks --poolOptions.forks.singleFork=true",
    "docker:up": "cd ../.. && docker-compose up -d redis",
    "docker:down": "cd ../.. && docker-compose down",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepublishOnly": "node ../../scripts/check-changelog.mjs"
  },
  "keywords": [
    "nestjs",
    "redis",
    "pubsub",
    "publish-subscribe",
    "real-time",
    "events",
    "websocket",
    "broadcast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs-redisx/nestjs-redisx.git",
    "directory": "packages/pubsub"
  },
  "homepage": "https://nestjs-redisx.dev/en/reference/pubsub/",
  "bugs": {
    "url": "https://github.com/nestjs-redisx/nestjs-redisx/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@nestjs-redisx/core": "^1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs-redisx/testing": "^1.12.0",
    "@nestjs/testing": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
